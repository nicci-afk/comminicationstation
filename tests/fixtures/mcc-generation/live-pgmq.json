  "pgmq_format_definition": "CREATE OR REPLACE FUNCTION pgmq.format_table_name(queue_name text, prefix text)\n RETURNS text\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n    IF queue_name ~ '\\$|;|--|'''\n    THEN\n        RAISE EXCEPTION 'queue name contains invalid characters: $, ;, --, or \\''';\n    END IF;\n    RETURN lower(prefix || '_' || queue_name);\nEND;\n$function$\n"
